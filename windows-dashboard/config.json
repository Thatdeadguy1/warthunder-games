{
  "title": "CYBER DECK",
  "theme": "Dark",
  "browser": "Opera",
  "ghostEspPanel": "%USERPROFILE%\\Downloads\\ghostesp_9.html",
  "autoOpenGhostEspOnDevStart": true,
  "devStartApps": ["Opera", "Windows Terminal", "Docker Desktop", "Wireshark"],

  "apps": [
    {
      "name": "Opera",
      "group": "Core",
      "paths": ["%LOCALAPPDATA%\\Programs\\Opera\\opera.exe", "%ProgramFiles%\\Opera\\opera.exe", "opera.exe"]
    },
    {
      "name": "Windows Terminal",
      "group": "Core",
      "paths": ["wt.exe"]
    },
    {
      "name": "Docker Desktop",
      "group": "Core",
      "paths": ["%ProgramFiles%\\Docker\\Docker\\Docker Desktop.exe"]
    },
    {
      "name": "Wireshark",
      "group": "Core",
      "paths": ["%ProgramFiles%\\Wireshark\\Wireshark.exe"]
    },
    {
      "name": "VS Code",
      "group": "Dev",
      "paths": ["%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\Code.exe", "%ProgramFiles%\\Microsoft VS Code\\Code.exe"]
    },
    {
      "name": "Arduino IDE",
      "group": "Dev",
      "paths": ["%LOCALAPPDATA%\\Programs\\Arduino IDE\\Arduino IDE.exe", "%ProgramFiles%\\Arduino IDE\\Arduino IDE.exe"]
    },
    {
      "name": "Raspberry Pi Imager",
      "group": "Dev",
      "paths": ["%ProgramFiles%\\Raspberry Pi Imager\\rpi-imager.exe", "%ProgramFiles(x86)%\\Raspberry Pi Imager\\rpi-imager.exe"]
    },
    {
      "name": "Zenmap (Nmap)",
      "group": "Dev",
      "paths": ["%ProgramFiles(x86)%\\Nmap\\zenmap.exe", "%ProgramFiles%\\Nmap\\zenmap.exe"]
    },
    {
      "name": "PowerShell (Admin)",
      "group": "System",
      "paths": ["powershell.exe"],
      "admin": true
    },
    {
      "name": "Device Manager",
      "group": "System",
      "paths": ["devmgmt.msc"]
    },
    {
      "name": "Task Manager",
      "group": "System",
      "paths": ["taskmgr.exe"]
    },
    {
      "name": "Network Connections",
      "group": "System",
      "paths": ["ncpa.cpl"]
    }
  ],

  "sites": [
    { "name": "TryHackMe",             "group": "Train",    "url": "https://tryhackme.com" },
    { "name": "Hack The Box",          "group": "Train",    "url": "https://www.hackthebox.com" },
    { "name": "OverTheWire",           "group": "Train",    "url": "https://overthewire.org/wargames/" },
    { "name": "PortSwigger Academy",   "group": "Train",    "url": "https://portswigger.net/web-security" },
    { "name": "picoCTF",               "group": "Train",    "url": "https://picoctf.org" },

    { "name": "CyberChef",             "group": "Tools",    "url": "https://gchq.github.io/CyberChef/" },
    { "name": "GTFOBins",              "group": "Tools",    "url": "https://gtfobins.github.io/" },
    { "name": "Shodan",                "group": "Tools",    "url": "https://www.shodan.io" },
    { "name": "VirusTotal",            "group": "Tools",    "url": "https://www.virustotal.com" },
    { "name": "crt.sh",                "group": "Tools",    "url": "https://crt.sh" },

    { "name": "NVD",                   "group": "Intel",    "url": "https://nvd.nist.gov" },
    { "name": "CVE.org",               "group": "Intel",    "url": "https://www.cve.org" },
    { "name": "Exploit-DB",            "group": "Intel",    "url": "https://www.exploit-db.com" },
    { "name": "CISA KEV",              "group": "Intel",    "url": "https://www.cisa.gov/known-exploited-vulnerabilities-catalog" },

    { "name": "ESP-IDF Docs (S3)",     "group": "Hardware", "url": "https://docs.espressif.com/projects/esp-idf/en/latest/esp32s3/" },
    { "name": "esptool-js Flasher",    "group": "Hardware", "url": "https://espressif.github.io/esptool-js/" },
    { "name": "Raspberry Pi Docs",     "group": "Hardware", "url": "https://www.raspberrypi.com/documentation/" },
    { "name": "Wireshark Docs",        "group": "Hardware", "url": "https://www.wireshark.org/docs/" },
    { "name": "Docker Hub",            "group": "Hardware", "url": "https://hub.docker.com" }
  ]
}
